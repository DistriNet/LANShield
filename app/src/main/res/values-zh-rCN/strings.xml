    <string name="info">信息</string>
    <string name="intro_default_policy">"首先，您需要选择默认是拦截还是允许局域网访问。之后您可以针对各个应用单独覆盖此规则。"</string>
    <string name="intro_finished_feedback">"有任何反馈意见吗？您可以在“设置”标签页中向我们提交！"</string>
    <string name="intro_notification">"当应用首次尝试访问您的本地网络时，LANShield 会发送通知，以便您决定允许或拦截。通知仅用于此类本地网络访问事件。"</string>
    <string name="intro_share_app_usage_content">"为了让我们更深入地了解应用行为，我们希望获知哪些应用在使用过程中并未尝试访问局域网。为此，您可以选择与我们共享您的应用使用情况数据。"</string>
    <string name="intro_share_app_usage_title">共享应用使用情况</string>
    <string name="intro_share_lan_metrics">"LANShield 是比利时鲁汶大学（KU Leuven）的一项学术研究项目。通过共享设备上应用与本地网络交互的数据，您可以帮助我们了解应用访问局域网的原因。所有数据均完全匿名化，绝不会外泄或出售。"</string>
    <string name="intro_welcome">"您连接的本地网络中通常连接有打印机、摄像头、音响等各类设备。LANShield 可以让您自主掌控哪些应用可以访问它们，哪些不能。"</string>
    <string name="intro_welcome_vpn_reassurance">LANShield 通过建立本地虚拟 VPN 接口在设备端过滤局域网流量。您会在状态栏看到 VPN 图标，但没有任何数据会被发送至外部互联网。</string>
